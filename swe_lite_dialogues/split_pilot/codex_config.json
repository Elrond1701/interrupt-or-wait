{
  "provider": "codex_cli_chatgpt",
  "model": "gpt-6-luna",
  "reasoning_effort": "low",
  "max_invocations": 3,
  "timeout_seconds": 180,
  "max_input_bytes": 40000,
  "billing": "ChatGPT subscription allowance; no API-key fallback or USD conversion",
  "note": "Invocation count and timeout are local limits, not a hard token or weekly-quota cap. The wrapper never retries automatically, but the CLI may perform bounded internal network retries. Codex adds its own instructions. Record this as a Codex drafting workflow, not a bare-model API run.",
  "cli_overrides": {
    "forced_login_method": "chatgpt",
    "approval_policy": "never",
    "web_search": "disabled",
    "project_doc_max_bytes": 0,
    "model_reasoning_summary": "none",
    "history.persistence": "none",
    "features.shell_tool": false,
    "features.shell_snapshot": false,
    "features.apps": false,
    "features.plugins": false,
    "features.hooks": false,
    "features.multi_agent": false,
    "features.multi_agent_v2": false,
    "features.computer_use": false,
    "features.browser_use": false,
    "features.code_mode_host": false,
    "features.image_generation": false,
    "features.view_image": false,
    "features.skill_search": false,
    "features.skip_host_skill_discovery": true,
    "features.memories": false,
    "features.sleep_tool": false,
    "features.goals": false,
    "features.fast_mode": false,
    "features.ultrafast_mode": false,
    "features.unbounded_connection_retries": false
  }
}
